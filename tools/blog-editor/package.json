{
  "name": "blog-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Distraction-free Markdown editor for the blog. Builds to blog/editor/.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-bullet-list": "^3.31.3",
    "@tiptap/extension-code-block-lowlight": "^3.31.3",
    "@tiptap/extension-heading": "^3.31.3",
    "@tiptap/extension-typography": "^3.31.3",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/suggestion": "^3.31.3",
    "highlight.js": "^11.12.0",
    "idb-keyval": "^6.3.0",
    "jszip": "^3.10.2",
    "lowlight": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
